deepml motion 0.3
module corpus.deepml_motion.example_00016
policy deterministic
policy no_network
skeleton Rig00016 {
  joint Root parent none bind transform(vec3(0,0,0), quat.identity)
  joint Hip parent Root bind transform(vec3(0,1.7,0), quat.identity)
  joint Foot parent Hip bind transform(vec3(0,-0.7,0), quat.identity)
}
pose Idle00016 for Rig00016 { Root.rotation = quat.identity Hip.rotation = quat.axis_angle(y, 16deg) }
clip Clip00016 duration 2s interpolation cubic { channel Hip.rotation key 0s quat.identity key 1s quat.axis_angle(y, 20deg) }
verify motion_hash == "invalid-00016"
