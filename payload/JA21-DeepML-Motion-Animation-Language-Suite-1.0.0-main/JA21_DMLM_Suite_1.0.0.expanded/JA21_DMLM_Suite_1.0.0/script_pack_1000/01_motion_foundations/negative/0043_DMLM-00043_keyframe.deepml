deepml motion 0.3
module corpus.deepml_motion.example_00043
policy deterministic
policy no_network
skeleton Rig00043 {
  joint Root parent none bind transform(vec3(0,0,0), quat.identity)
  joint Hip parent Root bind transform(vec3(0,1.0,0), quat.identity)
  joint Foot parent Hip bind transform(vec3(0,-1.2,0), quat.identity)
}
pose Idle00043 for Rig00043 { Root.rotation = quat.identity Hip.rotation = quat.axis_angle(y, 3deg) }
clip Clip00043 duration 4s interpolation cubic { channel Hip.rotation key 0s quat.identity key 1s quat.axis_angle(y, 20deg) }
verify motion_hash == "invalid-00043"
