deepml motion 0.3
module corpus.deepml_motion.example_00097
policy deterministic
policy no_network
skeleton Rig00097 {
  joint Root parent none bind transform(vec3(0,0,0), quat.identity)
  joint Hip parent Root bind transform(vec3(0,1.3,0), quat.identity)
  joint Foot parent Hip bind transform(vec3(0,-1.1,0), quat.identity)
}
pose Idle00097 for Rig00097 { Root.rotation = quat.identity Hip.rotation = quat.axis_angle(y, 17deg) }
clip Clip00097 duration 3s interpolation cubic { channel Hip.rotation key 0s quat.identity key 1s quat.axis_angle(y, 20deg) }
verify motion_hash == "invalid-00097"
