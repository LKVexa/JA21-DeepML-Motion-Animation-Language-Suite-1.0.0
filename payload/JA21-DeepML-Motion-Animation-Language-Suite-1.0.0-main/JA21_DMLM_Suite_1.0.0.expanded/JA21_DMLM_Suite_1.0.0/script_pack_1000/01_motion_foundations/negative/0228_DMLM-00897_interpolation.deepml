deepml motion 0.3
module corpus.deepml_motion.example_00897
policy deterministic
policy no_network
skeleton Rig00897 {
  joint Root parent none bind transform(vec3(0,0,0), quat.identity)
  joint Hip parent Root bind transform(vec3(0,1.4,0), quat.identity)
  joint Foot parent Hip bind transform(vec3(0,-0.8,0), quat.identity)
