deepml motion 0.3
module corpus.deepml_motion.example_00012
policy deterministic
policy no_network
skeleton Rig00012 {
  joint Root parent none bind transform(vec3(0,0,0), quat.identity)
  joint Hip parent Root bind transform(vec3(0,1.3,0), quat.identity)
  joint Foot parent Hip bind transform(vec3(0,-0.3,0), quat.identity)
}
pose Idle00012 for Rig00012 { Root.rotation = quat.identity Hip.rotation = quat.axis_angle(y, 12deg) }
clip Clip00012 duration 3s interpolation cubic { channel Hip.rotation key 0s quat.identity key 1s quat.axis_angle(y, 20deg) }
