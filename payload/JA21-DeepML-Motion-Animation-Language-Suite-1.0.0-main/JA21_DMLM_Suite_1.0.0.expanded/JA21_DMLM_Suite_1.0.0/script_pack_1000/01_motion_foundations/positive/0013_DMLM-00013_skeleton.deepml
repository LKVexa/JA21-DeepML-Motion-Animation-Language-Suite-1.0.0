deepml motion 0.3
module corpus.deepml_motion.example_00013
policy deterministic
policy no_network
skeleton Rig00013 {
  joint Root parent none bind transform(vec3(0,0,0), quat.identity)
  joint Hip parent Root bind transform(vec3(0,1.4,0), quat.identity)
  joint Foot parent Hip bind transform(vec3(0,-0.4,0), quat.identity)
}
pose Idle00013 for Rig00013 { Root.rotation = quat.identity Hip.rotation = quat.axis_angle(y, 13deg) }
clip Clip00013 duration 4s interpolation cubic { channel Hip.rotation key 0s quat.identity key 1s quat.axis_angle(y, 20deg) }
