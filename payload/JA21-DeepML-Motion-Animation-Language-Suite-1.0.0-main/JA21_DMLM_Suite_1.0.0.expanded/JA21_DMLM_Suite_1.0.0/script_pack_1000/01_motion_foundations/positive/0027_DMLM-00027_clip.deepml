deepml motion 0.3
module corpus.deepml_motion.example_00027
policy deterministic
policy no_network
skeleton Rig00027 {
  joint Root parent none bind transform(vec3(0,0,0), quat.identity)
  joint Hip parent Root bind transform(vec3(0,1.1,0), quat.identity)
  joint Foot parent Hip bind transform(vec3(0,-0.7,0), quat.identity)
}
pose Idle00027 for Rig00027 { Root.rotation = quat.identity Hip.rotation = quat.axis_angle(y, 7deg) }
clip Clip00027 duration 3s interpolation cubic { channel Hip.rotation key 0s quat.identity key 1s quat.axis_angle(y, 20deg) }
