deepml motion 0.3
module corpus.deepml_motion.example_00028
policy deterministic
policy no_network
skeleton Rig00028 {
  joint Root parent none bind transform(vec3(0,0,0), quat.identity)
  joint Hip parent Root bind transform(vec3(0,1.2,0), quat.identity)
  joint Foot parent Hip bind transform(vec3(0,-0.8,0), quat.identity)
}
pose Idle00028 for Rig00028 { Root.rotation = quat.identity Hip.rotation = quat.axis_angle(y, 8deg) }
clip Clip00028 duration 4s interpolation cubic { channel Hip.rotation key 0s quat.identity key 1s quat.axis_angle(y, 20deg) }
