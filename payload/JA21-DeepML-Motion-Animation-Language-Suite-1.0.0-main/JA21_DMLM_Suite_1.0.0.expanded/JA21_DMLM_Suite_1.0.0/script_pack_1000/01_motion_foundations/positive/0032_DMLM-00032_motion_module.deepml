deepml motion 0.3
module corpus.deepml_motion.example_00032
policy deterministic
policy no_network
skeleton Rig00032 {
  joint Root parent none bind transform(vec3(0,0,0), quat.identity)
  joint Hip parent Root bind transform(vec3(0,1.6,0), quat.identity)
  joint Foot parent Hip bind transform(vec3(0,-1.2,0), quat.identity)
}
pose Idle00032 for Rig00032 { Root.rotation = quat.identity Hip.rotation = quat.axis_angle(y, 12deg) }
clip Clip00032 duration 3s interpolation cubic { channel Hip.rotation key 0s quat.identity key 1s quat.axis_angle(y, 20deg) }
