deepml motion 0.3
module corpus.deepml_motion.example_00034
policy deterministic
policy no_network
skeleton Rig00034 {
  joint Root parent none bind transform(vec3(0,0,0), quat.identity)
  joint Hip parent Root bind transform(vec3(0,0.1,0), quat.identity)
  joint Foot parent Hip bind transform(vec3(0,-0.3,0), quat.identity)
}
pose Idle00034 for Rig00034 { Root.rotation = quat.identity Hip.rotation = quat.axis_angle(y, 14deg) }
clip Clip00034 duration 5s interpolation cubic { channel Hip.rotation key 0s quat.identity key 1s quat.axis_angle(y, 20deg) }
