deepml motion 0.3
module corpus.deepml_motion.example_00042
policy deterministic
policy no_network
skeleton Rig00042 {
  joint Root parent none bind transform(vec3(0,0,0), quat.identity)
  joint Hip parent Root bind transform(vec3(0,0.9,0), quat.identity)
  joint Foot parent Hip bind transform(vec3(0,-1.1,0), quat.identity)
}
pose Idle00042 for Rig00042 { Root.rotation = quat.identity Hip.rotation = quat.axis_angle(y, 2deg) }
clip Clip00042 duration 3s interpolation cubic { channel Hip.rotation key 0s quat.identity key 1s quat.axis_angle(y, 20deg) }
