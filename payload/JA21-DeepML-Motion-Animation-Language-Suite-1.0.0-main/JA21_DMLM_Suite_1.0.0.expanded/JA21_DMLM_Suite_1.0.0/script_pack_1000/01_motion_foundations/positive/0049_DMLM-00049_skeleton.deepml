deepml motion 0.3
module corpus.deepml_motion.example_00049
policy deterministic
policy no_network
skeleton Rig00049 {
  joint Root parent none bind transform(vec3(0,0,0), quat.identity)
  joint Hip parent Root bind transform(vec3(0,1.6,0), quat.identity)
  joint Foot parent Hip bind transform(vec3(0,-0.7,0), quat.identity)
}
pose Idle00049 for Rig00049 { Root.rotation = quat.identity Hip.rotation = quat.axis_angle(y, 9deg) }
clip Clip00049 duration 5s interpolation cubic { channel Hip.rotation key 0s quat.identity key 1s quat.axis_angle(y, 20deg) }
