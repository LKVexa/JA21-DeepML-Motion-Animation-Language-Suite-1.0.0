deepml motion 0.3
module corpus.deepml_motion.example_00050
policy deterministic
policy no_network
skeleton Rig00050 {
  joint Root parent none bind transform(vec3(0,0,0), quat.identity)
  joint Hip parent Root bind transform(vec3(0,1.7,0), quat.identity)
  joint Foot parent Hip bind transform(vec3(0,-0.8,0), quat.identity)
}
pose Idle00050 for Rig00050 { Root.rotation = quat.identity Hip.rotation = quat.axis_angle(y, 10deg) }
clip Clip00050 duration 1s interpolation cubic { channel Hip.rotation key 0s quat.identity key 1s quat.axis_angle(y, 20deg) }
