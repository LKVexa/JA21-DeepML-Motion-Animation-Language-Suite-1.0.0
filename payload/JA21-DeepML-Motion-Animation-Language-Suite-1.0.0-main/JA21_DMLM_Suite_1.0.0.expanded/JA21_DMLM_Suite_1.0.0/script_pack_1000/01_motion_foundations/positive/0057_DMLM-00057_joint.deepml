deepml motion 0.3
module corpus.deepml_motion.example_00057
policy deterministic
policy no_network
skeleton Rig00057 {
  joint Root parent none bind transform(vec3(0,0,0), quat.identity)
  joint Hip parent Root bind transform(vec3(0,0.7,0), quat.identity)
  joint Foot parent Hip bind transform(vec3(0,-0.4,0), quat.identity)
}
pose Idle00057 for Rig00057 { Root.rotation = quat.identity Hip.rotation = quat.axis_angle(y, 17deg) }
clip Clip00057 duration 3s interpolation cubic { channel Hip.rotation key 0s quat.identity key 1s quat.axis_angle(y, 20deg) }
