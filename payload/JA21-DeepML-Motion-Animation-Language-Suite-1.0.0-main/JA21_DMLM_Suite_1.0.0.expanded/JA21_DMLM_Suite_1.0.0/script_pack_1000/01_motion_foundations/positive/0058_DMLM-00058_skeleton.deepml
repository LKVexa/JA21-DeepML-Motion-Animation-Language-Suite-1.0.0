deepml motion 0.3
module corpus.deepml_motion.example_00058
policy deterministic
policy no_network
skeleton Rig00058 {
  joint Root parent none bind transform(vec3(0,0,0), quat.identity)
  joint Hip parent Root bind transform(vec3(0,0.8,0), quat.identity)
  joint Foot parent Hip bind transform(vec3(0,-0.5,0), quat.identity)
}
pose Idle00058 for Rig00058 { Root.rotation = quat.identity Hip.rotation = quat.axis_angle(y, 18deg) }
clip Clip00058 duration 4s interpolation cubic { channel Hip.rotation key 0s quat.identity key 1s quat.axis_angle(y, 20deg) }
