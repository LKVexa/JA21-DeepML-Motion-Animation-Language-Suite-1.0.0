deepml motion 0.3
module corpus.deepml_motion.example_00064
policy deterministic
policy no_network
skeleton Rig00064 {
  joint Root parent none bind transform(vec3(0,0,0), quat.identity)
  joint Hip parent Root bind transform(vec3(0,1.4,0), quat.identity)
  joint Foot parent Hip bind transform(vec3(0,-1.1,0), quat.identity)
}
pose Idle00064 for Rig00064 { Root.rotation = quat.identity Hip.rotation = quat.axis_angle(y, 4deg) }
clip Clip00064 duration 5s interpolation cubic { channel Hip.rotation key 0s quat.identity key 1s quat.axis_angle(y, 20deg) }
