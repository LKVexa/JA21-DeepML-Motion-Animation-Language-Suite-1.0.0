deepml motion 0.3
module corpus.deepml_motion.example_00067
policy deterministic
policy no_network
skeleton Rig00067 {
  joint Root parent none bind transform(vec3(0,0,0), quat.identity)
  joint Hip parent Root bind transform(vec3(0,1.7,0), quat.identity)
  joint Foot parent Hip bind transform(vec3(0,-0.3,0), quat.identity)
}
pose Idle00067 for Rig00067 { Root.rotation = quat.identity Hip.rotation = quat.axis_angle(y, 7deg) }
clip Clip00067 duration 3s interpolation cubic { channel Hip.rotation key 0s quat.identity key 1s quat.axis_angle(y, 20deg) }
