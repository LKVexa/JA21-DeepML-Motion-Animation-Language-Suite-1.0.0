deepml motion 0.3
module corpus.deepml_motion.example_00083
policy deterministic
policy no_network
skeleton Rig00083 {
  joint Root parent none bind transform(vec3(0,0,0), quat.identity)
  joint Hip parent Root bind transform(vec3(0,1.6,0), quat.identity)
  joint Foot parent Hip bind transform(vec3(0,-0.8,0), quat.identity)
}
pose Idle00083 for Rig00083 { Root.rotation = quat.identity Hip.rotation = quat.axis_angle(y, 3deg) }
clip Clip00083 duration 4s interpolation cubic { channel Hip.rotation key 0s quat.identity key 1s quat.axis_angle(y, 20deg) }
