deepml motion 0.3
module corpus.deepml_motion.example_00091
policy deterministic
policy no_network
skeleton Rig00091 {
  joint Root parent none bind transform(vec3(0,0,0), quat.identity)
  joint Hip parent Root bind transform(vec3(0,0.7,0), quat.identity)
  joint Foot parent Hip bind transform(vec3(0,-0.5,0), quat.identity)
}
pose Idle00091 for Rig00091 { Root.rotation = quat.identity Hip.rotation = quat.axis_angle(y, 11deg) }
clip Clip00091 duration 2s interpolation cubic { channel Hip.rotation key 0s quat.identity key 1s quat.axis_angle(y, 20deg) }
