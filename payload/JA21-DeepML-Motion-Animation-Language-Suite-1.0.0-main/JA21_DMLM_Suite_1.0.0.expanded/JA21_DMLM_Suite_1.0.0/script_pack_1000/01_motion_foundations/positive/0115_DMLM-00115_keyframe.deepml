deepml motion 0.3
module corpus.deepml_motion.example_00115
policy deterministic
policy no_network
skeleton Rig00115 {
  joint Root parent none bind transform(vec3(0,0,0), quat.identity)
  joint Hip parent Root bind transform(vec3(0,1.4,0), quat.identity)
  joint Foot parent Hip bind transform(vec3(0,-0.7,0), quat.identity)
}
pose Idle00115 for Rig00115 { Root.rotation = quat.identity Hip.rotation = quat.axis_angle(y, 15deg) }
clip Clip00115 duration 1s interpolation cubic { channel Hip.rotation key 0s quat.identity key 1s quat.axis_angle(y, 20deg) }
