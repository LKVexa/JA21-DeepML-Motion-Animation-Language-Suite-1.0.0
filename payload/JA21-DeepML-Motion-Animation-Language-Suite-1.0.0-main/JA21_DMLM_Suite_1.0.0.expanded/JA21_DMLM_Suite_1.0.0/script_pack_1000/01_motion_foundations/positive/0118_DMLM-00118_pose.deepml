deepml motion 0.3
module corpus.deepml_motion.example_00118
policy deterministic
policy no_network
skeleton Rig00118 {
  joint Root parent none bind transform(vec3(0,0,0), quat.identity)
  joint Hip parent Root bind transform(vec3(0,1.7,0), quat.identity)
  joint Foot parent Hip bind transform(vec3(0,-1.0,0), quat.identity)
}
pose Idle00118 for Rig00118 { Root.rotation = quat.identity Hip.rotation = quat.axis_angle(y, 18deg) }
clip Clip00118 duration 4s interpolation cubic { channel Hip.rotation key 0s quat.identity key 1s quat.axis_angle(y, 20deg) }
