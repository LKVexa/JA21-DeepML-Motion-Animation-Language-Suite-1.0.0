deepml motion 0.3
module corpus.deepml_motion.example_00119
policy deterministic
policy no_network
skeleton Rig00119 {
  joint Root parent none bind transform(vec3(0,0,0), quat.identity)
  joint Hip parent Root bind transform(vec3(0,0.1,0), quat.identity)
  joint Foot parent Hip bind transform(vec3(0,-1.1,0), quat.identity)
}
pose Idle00119 for Rig00119 { Root.rotation = quat.identity Hip.rotation = quat.axis_angle(y, 19deg) }
clip Clip00119 duration 5s interpolation cubic { channel Hip.rotation key 0s quat.identity key 1s quat.axis_angle(y, 20deg) }
