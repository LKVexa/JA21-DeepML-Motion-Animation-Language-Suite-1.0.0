deepml motion 0.3
module corpus.deepml_motion.example_00141
policy deterministic
policy no_network
skeleton Rig00141 {
  joint Root parent none bind transform(vec3(0,0,0), quat.identity)
  joint Hip parent Root bind transform(vec3(0,0.6,0), quat.identity)
  joint Foot parent Hip bind transform(vec3(0,-1.1,0), quat.identity)
}
pose Idle00141 for Rig00141 { Root.rotation = quat.identity Hip.rotation = quat.axis_angle(y, 1deg) }
clip Clip00141 duration 2s interpolation cubic { channel Hip.rotation key 0s quat.identity key 1s quat.axis_angle(y, 20deg) }
