deepml motion 0.3
module corpus.deepml_motion.example_00150
policy deterministic
policy no_network
skeleton Rig00150 {
  joint Root parent none bind transform(vec3(0,0,0), quat.identity)
  joint Hip parent Root bind transform(vec3(0,1.5,0), quat.identity)
  joint Foot parent Hip bind transform(vec3(0,-0.9,0), quat.identity)
}
pose Idle00150 for Rig00150 { Root.rotation = quat.identity Hip.rotation = quat.axis_angle(y, 10deg) }
clip Clip00150 duration 1s interpolation cubic { channel Hip.rotation key 0s quat.identity key 1s quat.axis_angle(y, 20deg) }
