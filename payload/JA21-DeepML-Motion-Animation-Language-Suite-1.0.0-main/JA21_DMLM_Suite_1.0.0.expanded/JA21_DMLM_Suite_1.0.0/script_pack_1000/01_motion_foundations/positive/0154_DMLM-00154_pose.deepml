deepml motion 0.3
module corpus.deepml_motion.example_00154
policy deterministic
policy no_network
skeleton Rig00154 {
  joint Root parent none bind transform(vec3(0,0,0), quat.identity)
  joint Hip parent Root bind transform(vec3(0,0.2,0), quat.identity)
  joint Foot parent Hip bind transform(vec3(0,-0.2,0), quat.identity)
}
pose Idle00154 for Rig00154 { Root.rotation = quat.identity Hip.rotation = quat.axis_angle(y, 14deg) }
clip Clip00154 duration 5s interpolation cubic { channel Hip.rotation key 0s quat.identity key 1s quat.axis_angle(y, 20deg) }
