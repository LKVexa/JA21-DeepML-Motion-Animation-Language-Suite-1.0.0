deepml motion 0.3
module corpus.deepml_motion.example_00169
policy deterministic
policy no_network
skeleton Rig00169 {
  joint Root parent none bind transform(vec3(0,0,0), quat.identity)
  joint Hip parent Root bind transform(vec3(0,1.7,0), quat.identity)
  joint Foot parent Hip bind transform(vec3(0,-0.6,0), quat.identity)
}
pose Idle00169 for Rig00169 { Root.rotation = quat.identity Hip.rotation = quat.axis_angle(y, 9deg) }
clip Clip00169 duration 5s interpolation cubic { channel Hip.rotation key 0s quat.identity key 1s quat.axis_angle(y, 20deg) }
