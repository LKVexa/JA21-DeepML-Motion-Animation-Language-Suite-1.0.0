deepml motion 0.3
module corpus.deepml_motion.example_02510
policy deterministic
policy no_network
skeleton Rig02510 { joint Root parent none joint Hip parent Root joint FootL parent Hip joint FootR parent Hip }
procedural animation Procedural02510 seed 2510 {
  trajectory = predict_trajectory(velocity, horizon=1.0s)
  match = motion_match(database="local:motions_8", trajectory=trajectory)
  constrain contact FootL to ground when phase < 0.5
  constrain contact FootR to ground when phase >= 0.5
}
layered state_machine Layers02510 { base: Locomotion upper: Gesture additive: Breathing }
synchronize Procedural02510 with scene.Actor11 and timeline.Sequence1
verify motion_hash == "invalid-02510"
