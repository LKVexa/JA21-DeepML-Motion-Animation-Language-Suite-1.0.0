deepml motion 0.3
module corpus.deepml_motion.example_02521
policy deterministic
policy no_network
skeleton Rig02521 { joint Root parent none joint Hip parent Root joint FootL parent Hip joint FootR parent Hip }
procedural animation Procedural02521 seed 2521 {
  trajectory = predict_trajectory(velocity, horizon=1.0s)
  match = motion_match(database="local:motions_1", trajectory=trajectory)
  constrain contact FootL to ground when phase < 0.5
  constrain contact FootR to ground when phase >= 0.5
}
layered state_machine Layers02521 { base: Locomotion upper: Gesture additive: Breathing }
synchronize Procedural02521 with scene.Actor5 and timeline.Sequence12
verify motion_hash == "invalid-02521"
