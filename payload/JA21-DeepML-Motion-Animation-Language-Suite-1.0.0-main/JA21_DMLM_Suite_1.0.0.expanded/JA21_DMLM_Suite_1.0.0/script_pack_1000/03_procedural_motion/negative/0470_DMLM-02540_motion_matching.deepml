deepml motion 0.3
module corpus.deepml_motion.example_02540
policy deterministic
policy no_network
skeleton Rig02540 { joint Root parent none joint Hip parent Root joint FootL parent Hip joint FootR parent Hip }
procedural animation Procedural02540 seed 2540 {
  trajectory = predict_trajectory(velocity, horizon=1.0s)
  match = motion_match(database="local:motions_2", trajectory=trajectory)
  constrain contact FootL to ground when phase < 0.5
  constrain contact FootR to ground when phase >= 0.5
}
layered state_machine Layers02540 { base: Locomotion upper: Gesture additive: Breathing }
synchronize Procedural02540 with scene.Actor7 and timeline.Sequence5
verify motion_hash == "invalid-02540"
