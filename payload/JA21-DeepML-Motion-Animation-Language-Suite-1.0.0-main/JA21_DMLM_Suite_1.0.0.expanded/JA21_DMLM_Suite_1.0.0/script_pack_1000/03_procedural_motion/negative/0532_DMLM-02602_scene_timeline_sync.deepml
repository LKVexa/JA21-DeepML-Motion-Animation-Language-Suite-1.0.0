deepml motion 0.3
module corpus.deepml_motion.example_02602
policy deterministic
policy no_network
skeleton Rig02602 { joint Root parent none joint Hip parent Root joint FootL parent Hip joint FootR parent Hip }
procedural animation Procedural02602 seed 2602 {
  trajectory = predict_trajectory(velocity, horizon=1.0s)
