deepml motion 0.3
module corpus.deepml_motion.example_02610
policy deterministic
policy no_network
skeleton Rig02610 { joint Root parent none joint Hip parent Root joint FootL parent Hip joint FootR parent Hip }
procedural animation Procedural02610 seed 2610 {
  trajectory = predict_trajectory(velocity, horizon=1.0s)
  match = motion_match(database="local:motions_0", trajectory=trajectory)
  constrain contact FootL to ground when phase < 0.5
  constrain contact FootR to ground when phase >= 0.5
}
layered state_machine Layers02610 { base: Locomotion upper: Gesture additive: Breathing }
synchronize Procedural02610 with scene.Actor9 and timeline.Sequence10
verify motion_hash == "invalid-02610"
