deepml motion 0.3
module corpus.deepml_motion.example_02512
policy deterministic
policy no_network
skeleton Rig02512 { joint Root parent none joint Hip parent Root joint FootL parent Hip joint FootR parent Hip }
procedural animation Procedural02512 seed 2512 {
  trajectory = predict_trajectory(velocity, horizon=1.0s)
  match = motion_match(database="local:motions_1", trajectory=trajectory)
  constrain contact FootL to ground when phase < 0.5
  constrain contact FootR to ground when phase >= 0.5
}
layered state_machine Layers02512 { base: Locomotion upper: Gesture additive: Breathing }
synchronize Procedural02512 with scene.Actor13 and timeline.Sequence3
