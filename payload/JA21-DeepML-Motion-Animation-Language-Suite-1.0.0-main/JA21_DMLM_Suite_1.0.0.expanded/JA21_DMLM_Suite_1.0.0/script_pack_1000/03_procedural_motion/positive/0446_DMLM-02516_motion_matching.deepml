deepml motion 0.3
module corpus.deepml_motion.example_02516
policy deterministic
policy no_network
skeleton Rig02516 { joint Root parent none joint Hip parent Root joint FootL parent Hip joint FootR parent Hip }
procedural animation Procedural02516 seed 2516 {
  trajectory = predict_trajectory(velocity, horizon=1.0s)
  match = motion_match(database="local:motions_5", trajectory=trajectory)
  constrain contact FootL to ground when phase < 0.5
  constrain contact FootR to ground when phase >= 0.5
}
layered state_machine Layers02516 { base: Locomotion upper: Gesture additive: Breathing }
synchronize Procedural02516 with scene.Actor0 and timeline.Sequence7
