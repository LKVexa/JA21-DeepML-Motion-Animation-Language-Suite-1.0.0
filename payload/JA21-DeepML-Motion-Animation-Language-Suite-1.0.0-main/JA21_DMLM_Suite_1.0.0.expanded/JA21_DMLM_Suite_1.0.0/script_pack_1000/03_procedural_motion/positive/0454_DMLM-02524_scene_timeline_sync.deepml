deepml motion 0.3
module corpus.deepml_motion.example_02524
policy deterministic
policy no_network
skeleton Rig02524 { joint Root parent none joint Hip parent Root joint FootL parent Hip joint FootR parent Hip }
procedural animation Procedural02524 seed 2524 {
  trajectory = predict_trajectory(velocity, horizon=1.0s)
  match = motion_match(database="local:motions_4", trajectory=trajectory)
  constrain contact FootL to ground when phase < 0.5
  constrain contact FootR to ground when phase >= 0.5
}
layered state_machine Layers02524 { base: Locomotion upper: Gesture additive: Breathing }
synchronize Procedural02524 with scene.Actor8 and timeline.Sequence2
