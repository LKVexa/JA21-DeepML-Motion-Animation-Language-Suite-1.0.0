deepml motion 0.3
module corpus.deepml_motion.example_02533
policy deterministic
policy no_network
skeleton Rig02533 { joint Root parent none joint Hip parent Root joint FootL parent Hip joint FootR parent Hip }
procedural animation Procedural02533 seed 2533 {
  trajectory = predict_trajectory(velocity, horizon=1.0s)
  match = motion_match(database="local:motions_4", trajectory=trajectory)
  constrain contact FootL to ground when phase < 0.5
  constrain contact FootR to ground when phase >= 0.5
}
layered state_machine Layers02533 { base: Locomotion upper: Gesture additive: Breathing }
synchronize Procedural02533 with scene.Actor0 and timeline.Sequence11
