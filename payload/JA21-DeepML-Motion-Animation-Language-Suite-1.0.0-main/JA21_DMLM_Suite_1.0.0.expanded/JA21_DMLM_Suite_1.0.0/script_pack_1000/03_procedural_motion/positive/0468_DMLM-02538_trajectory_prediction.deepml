deepml motion 0.3
module corpus.deepml_motion.example_02538
policy deterministic
policy no_network
skeleton Rig02538 { joint Root parent none joint Hip parent Root joint FootL parent Hip joint FootR parent Hip }
procedural animation Procedural02538 seed 2538 {
  trajectory = predict_trajectory(velocity, horizon=1.0s)
  match = motion_match(database="local:motions_0", trajectory=trajectory)
  constrain contact FootL to ground when phase < 0.5
  constrain contact FootR to ground when phase >= 0.5
}
layered state_machine Layers02538 { base: Locomotion upper: Gesture additive: Breathing }
synchronize Procedural02538 with scene.Actor5 and timeline.Sequence3
