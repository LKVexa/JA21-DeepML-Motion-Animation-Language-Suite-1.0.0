deepml motion 0.3
module corpus.deepml_motion.example_02539
policy deterministic
policy no_network
skeleton Rig02539 { joint Root parent none joint Hip parent Root joint FootL parent Hip joint FootR parent Hip }
procedural animation Procedural02539 seed 2539 {
  trajectory = predict_trajectory(velocity, horizon=1.0s)
  match = motion_match(database="local:motions_1", trajectory=trajectory)
  constrain contact FootL to ground when phase < 0.5
  constrain contact FootR to ground when phase >= 0.5
}
layered state_machine Layers02539 { base: Locomotion upper: Gesture additive: Breathing }
synchronize Procedural02539 with scene.Actor6 and timeline.Sequence4
