deepml motion 0.3
module corpus.deepml_motion.example_02566
policy deterministic
policy no_network
skeleton Rig02566 { joint Root parent none joint Hip parent Root joint FootL parent Hip joint FootR parent Hip }
procedural animation Procedural02566 seed 2566 {
  trajectory = predict_trajectory(velocity, horizon=1.0s)
  match = motion_match(database="local:motions_1", trajectory=trajectory)
  constrain contact FootL to ground when phase < 0.5
  constrain contact FootR to ground when phase >= 0.5
}
layered state_machine Layers02566 { base: Locomotion upper: Gesture additive: Breathing }
synchronize Procedural02566 with scene.Actor16 and timeline.Sequence5
