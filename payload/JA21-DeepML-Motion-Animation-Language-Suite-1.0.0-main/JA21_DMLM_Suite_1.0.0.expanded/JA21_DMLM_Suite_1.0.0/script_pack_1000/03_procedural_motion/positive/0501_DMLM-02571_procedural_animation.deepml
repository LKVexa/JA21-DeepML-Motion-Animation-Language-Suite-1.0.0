deepml motion 0.3
module corpus.deepml_motion.example_02571
policy deterministic
policy no_network
skeleton Rig02571 { joint Root parent none joint Hip parent Root joint FootL parent Hip joint FootR parent Hip }
procedural animation Procedural02571 seed 2571 {
  trajectory = predict_trajectory(velocity, horizon=1.0s)
  match = motion_match(database="local:motions_6", trajectory=trajectory)
  constrain contact FootL to ground when phase < 0.5
  constrain contact FootR to ground when phase >= 0.5
}
layered state_machine Layers02571 { base: Locomotion upper: Gesture additive: Breathing }
synchronize Procedural02571 with scene.Actor4 and timeline.Sequence10
