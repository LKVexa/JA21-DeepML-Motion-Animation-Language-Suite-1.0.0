deepml motion 0.3
module corpus.deepml_motion.example_02580
policy deterministic
policy no_network
skeleton Rig02580 { joint Root parent none joint Hip parent Root joint FootL parent Hip joint FootR parent Hip }
procedural animation Procedural02580 seed 2580 {
  trajectory = predict_trajectory(velocity, horizon=1.0s)
  match = motion_match(database="local:motions_6", trajectory=trajectory)
  constrain contact FootL to ground when phase < 0.5
  constrain contact FootR to ground when phase >= 0.5
}
layered state_machine Layers02580 { base: Locomotion upper: Gesture additive: Breathing }
synchronize Procedural02580 with scene.Actor13 and timeline.Sequence6
