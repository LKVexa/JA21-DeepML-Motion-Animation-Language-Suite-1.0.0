deepml motion 0.3
module corpus.deepml_motion.example_02588
policy deterministic
policy no_network
skeleton Rig02588 { joint Root parent none joint Hip parent Root joint FootL parent Hip joint FootR parent Hip }
procedural animation Procedural02588 seed 2588 {
  trajectory = predict_trajectory(velocity, horizon=1.0s)
  match = motion_match(database="local:motions_5", trajectory=trajectory)
  constrain contact FootL to ground when phase < 0.5
  constrain contact FootR to ground when phase >= 0.5
}
layered state_machine Layers02588 { base: Locomotion upper: Gesture additive: Breathing }
synchronize Procedural02588 with scene.Actor4 and timeline.Sequence1
