deepml motion 0.3
module corpus.deepml_motion.example_02589
policy deterministic
policy no_network
skeleton Rig02589 { joint Root parent none joint Hip parent Root joint FootL parent Hip joint FootR parent Hip }
procedural animation Procedural02589 seed 2589 {
  trajectory = predict_trajectory(velocity, horizon=1.0s)
  match = motion_match(database="local:motions_6", trajectory=trajectory)
  constrain contact FootL to ground when phase < 0.5
  constrain contact FootR to ground when phase >= 0.5
}
layered state_machine Layers02589 { base: Locomotion upper: Gesture additive: Breathing }
synchronize Procedural02589 with scene.Actor5 and timeline.Sequence2
