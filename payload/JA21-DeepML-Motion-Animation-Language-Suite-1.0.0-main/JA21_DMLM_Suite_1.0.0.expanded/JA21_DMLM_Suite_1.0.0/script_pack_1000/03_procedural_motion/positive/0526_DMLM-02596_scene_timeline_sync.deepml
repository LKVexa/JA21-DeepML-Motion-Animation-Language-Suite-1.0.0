deepml motion 0.3
module corpus.deepml_motion.example_02596
policy deterministic
policy no_network
skeleton Rig02596 { joint Root parent none joint Hip parent Root joint FootL parent Hip joint FootR parent Hip }
procedural animation Procedural02596 seed 2596 {
  trajectory = predict_trajectory(velocity, horizon=1.0s)
  match = motion_match(database="local:motions_4", trajectory=trajectory)
  constrain contact FootL to ground when phase < 0.5
  constrain contact FootR to ground when phase >= 0.5
}
layered state_machine Layers02596 { base: Locomotion upper: Gesture additive: Breathing }
synchronize Procedural02596 with scene.Actor12 and timeline.Sequence9
