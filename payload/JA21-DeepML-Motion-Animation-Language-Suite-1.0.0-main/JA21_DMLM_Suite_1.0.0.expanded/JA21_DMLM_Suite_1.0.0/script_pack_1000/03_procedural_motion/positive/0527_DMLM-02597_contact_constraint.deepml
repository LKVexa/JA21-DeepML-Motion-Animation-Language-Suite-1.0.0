deepml motion 0.3
module corpus.deepml_motion.example_02597
policy deterministic
policy no_network
skeleton Rig02597 { joint Root parent none joint Hip parent Root joint FootL parent Hip joint FootR parent Hip }
procedural animation Procedural02597 seed 2597 {
  trajectory = predict_trajectory(velocity, horizon=1.0s)
  match = motion_match(database="local:motions_5", trajectory=trajectory)
  constrain contact FootL to ground when phase < 0.5
  constrain contact FootR to ground when phase >= 0.5
}
layered state_machine Layers02597 { base: Locomotion upper: Gesture additive: Breathing }
synchronize Procedural02597 with scene.Actor13 and timeline.Sequence10
