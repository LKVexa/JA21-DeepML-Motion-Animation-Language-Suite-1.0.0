deepml motion 0.3
module corpus.deepml_motion.example_02599
policy deterministic
policy no_network
skeleton Rig02599 { joint Root parent none joint Hip parent Root joint FootL parent Hip joint FootR parent Hip }
procedural animation Procedural02599 seed 2599 {
  trajectory = predict_trajectory(velocity, horizon=1.0s)
  match = motion_match(database="local:motions_7", trajectory=trajectory)
  constrain contact FootL to ground when phase < 0.5
  constrain contact FootR to ground when phase >= 0.5
}
layered state_machine Layers02599 { base: Locomotion upper: Gesture additive: Breathing }
synchronize Procedural02599 with scene.Actor15 and timeline.Sequence12
