deepml motion 0.3
module corpus.deepml_motion.example_02618
policy deterministic
policy no_network
skeleton Rig02618 { joint Root parent none joint Hip parent Root joint FootL parent Hip joint FootR parent Hip }
procedural animation Procedural02618 seed 2618 {
  trajectory = predict_trajectory(velocity, horizon=1.0s)
  match = motion_match(database="local:motions_8", trajectory=trajectory)
  constrain contact FootL to ground when phase < 0.5
  constrain contact FootR to ground when phase >= 0.5
}
layered state_machine Layers02618 { base: Locomotion upper: Gesture additive: Breathing }
synchronize Procedural02618 with scene.Actor0 and timeline.Sequence5
