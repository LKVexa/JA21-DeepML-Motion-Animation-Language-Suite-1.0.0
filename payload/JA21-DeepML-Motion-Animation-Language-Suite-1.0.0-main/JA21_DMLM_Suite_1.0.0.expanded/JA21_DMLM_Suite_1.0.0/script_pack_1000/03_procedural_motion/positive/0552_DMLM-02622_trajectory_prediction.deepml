deepml motion 0.3
module corpus.deepml_motion.example_02622
policy deterministic
policy no_network
skeleton Rig02622 { joint Root parent none joint Hip parent Root joint FootL parent Hip joint FootR parent Hip }
procedural animation Procedural02622 seed 2622 {
  trajectory = predict_trajectory(velocity, horizon=1.0s)
  match = motion_match(database="local:motions_3", trajectory=trajectory)
  constrain contact FootL to ground when phase < 0.5
  constrain contact FootR to ground when phase >= 0.5
}
layered state_machine Layers02622 { base: Locomotion upper: Gesture additive: Breathing }
synchronize Procedural02622 with scene.Actor4 and timeline.Sequence9
