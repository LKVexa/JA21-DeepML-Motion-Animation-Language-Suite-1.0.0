deepml motion 0.3
module corpus.deepml_motion.example_02626
policy deterministic
policy no_network
skeleton Rig02626 { joint Root parent none joint Hip parent Root joint FootL parent Hip joint FootR parent Hip }
procedural animation Procedural02626 seed 2626 {
  trajectory = predict_trajectory(velocity, horizon=1.0s)
  match = motion_match(database="local:motions_7", trajectory=trajectory)
  constrain contact FootL to ground when phase < 0.5
  constrain contact FootR to ground when phase >= 0.5
}
layered state_machine Layers02626 { base: Locomotion upper: Gesture additive: Breathing }
synchronize Procedural02626 with scene.Actor8 and timeline.Sequence0
