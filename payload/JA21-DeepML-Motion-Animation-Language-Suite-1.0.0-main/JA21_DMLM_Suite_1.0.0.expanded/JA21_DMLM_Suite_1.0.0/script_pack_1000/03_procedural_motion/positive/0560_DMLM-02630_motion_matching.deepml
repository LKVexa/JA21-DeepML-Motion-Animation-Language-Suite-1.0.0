deepml motion 0.3
module corpus.deepml_motion.example_02630
policy deterministic
policy no_network
skeleton Rig02630 { joint Root parent none joint Hip parent Root joint FootL parent Hip joint FootR parent Hip }
procedural animation Procedural02630 seed 2630 {
  trajectory = predict_trajectory(velocity, horizon=1.0s)
  match = motion_match(database="local:motions_2", trajectory=trajectory)
  constrain contact FootL to ground when phase < 0.5
  constrain contact FootR to ground when phase >= 0.5
}
layered state_machine Layers02630 { base: Locomotion upper: Gesture additive: Breathing }
synchronize Procedural02630 with scene.Actor12 and timeline.Sequence4
