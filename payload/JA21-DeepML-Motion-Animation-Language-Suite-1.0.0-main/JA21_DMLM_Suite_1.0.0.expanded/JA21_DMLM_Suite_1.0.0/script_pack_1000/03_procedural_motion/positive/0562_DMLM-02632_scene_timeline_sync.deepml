deepml motion 0.3
module corpus.deepml_motion.example_02632
policy deterministic
policy no_network
skeleton Rig02632 { joint Root parent none joint Hip parent Root joint FootL parent Hip joint FootR parent Hip }
procedural animation Procedural02632 seed 2632 {
  trajectory = predict_trajectory(velocity, horizon=1.0s)
  match = motion_match(database="local:motions_4", trajectory=trajectory)
  constrain contact FootL to ground when phase < 0.5
  constrain contact FootR to ground when phase >= 0.5
}
layered state_machine Layers02632 { base: Locomotion upper: Gesture additive: Breathing }
synchronize Procedural02632 with scene.Actor14 and timeline.Sequence6
