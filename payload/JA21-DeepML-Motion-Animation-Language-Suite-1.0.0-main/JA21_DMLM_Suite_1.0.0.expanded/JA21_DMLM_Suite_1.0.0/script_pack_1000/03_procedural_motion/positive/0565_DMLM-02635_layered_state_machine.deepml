deepml motion 0.3
module corpus.deepml_motion.example_02635
policy deterministic
policy no_network
skeleton Rig02635 { joint Root parent none joint Hip parent Root joint FootL parent Hip joint FootR parent Hip }
procedural animation Procedural02635 seed 2635 {
  trajectory = predict_trajectory(velocity, horizon=1.0s)
  match = motion_match(database="local:motions_7", trajectory=trajectory)
  constrain contact FootL to ground when phase < 0.5
  constrain contact FootR to ground when phase >= 0.5
}
layered state_machine Layers02635 { base: Locomotion upper: Gesture additive: Breathing }
synchronize Procedural02635 with scene.Actor0 and timeline.Sequence9
