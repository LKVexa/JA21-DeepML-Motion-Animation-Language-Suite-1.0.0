deepml motion 0.3
module corpus.deepml_motion.example_02639
policy deterministic
policy no_network
skeleton Rig02639 { joint Root parent none joint Hip parent Root joint FootL parent Hip joint FootR parent Hip }
procedural animation Procedural02639 seed 2639 {
  trajectory = predict_trajectory(velocity, horizon=1.0s)
  match = motion_match(database="local:motions_2", trajectory=trajectory)
  constrain contact FootL to ground when phase < 0.5
  constrain contact FootR to ground when phase >= 0.5
}
layered state_machine Layers02639 { base: Locomotion upper: Gesture additive: Breathing }
synchronize Procedural02639 with scene.Actor4 and timeline.Sequence0
