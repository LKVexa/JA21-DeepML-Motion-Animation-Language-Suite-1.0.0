deepml motion 0.3
module corpus.deepml_motion.example_02641
policy deterministic
policy no_network
skeleton Rig02641 { joint Root parent none joint Hip parent Root joint FootL parent Hip joint FootR parent Hip }
procedural animation Procedural02641 seed 2641 {
  trajectory = predict_trajectory(velocity, horizon=1.0s)
  match = motion_match(database="local:motions_4", trajectory=trajectory)
  constrain contact FootL to ground when phase < 0.5
  constrain contact FootR to ground when phase >= 0.5
}
layered state_machine Layers02641 { base: Locomotion upper: Gesture additive: Breathing }
synchronize Procedural02641 with scene.Actor6 and timeline.Sequence2
