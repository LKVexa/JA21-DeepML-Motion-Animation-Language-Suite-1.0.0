deepml motion 0.3
module corpus.deepml_motion.example_02645
policy deterministic
policy no_network
skeleton Rig02645 { joint Root parent none joint Hip parent Root joint FootL parent Hip joint FootR parent Hip }
procedural animation Procedural02645 seed 2645 {
  trajectory = predict_trajectory(velocity, horizon=1.0s)
  match = motion_match(database="local:motions_8", trajectory=trajectory)
  constrain contact FootL to ground when phase < 0.5
  constrain contact FootR to ground when phase >= 0.5
}
layered state_machine Layers02645 { base: Locomotion upper: Gesture additive: Breathing }
synchronize Procedural02645 with scene.Actor10 and timeline.Sequence6
