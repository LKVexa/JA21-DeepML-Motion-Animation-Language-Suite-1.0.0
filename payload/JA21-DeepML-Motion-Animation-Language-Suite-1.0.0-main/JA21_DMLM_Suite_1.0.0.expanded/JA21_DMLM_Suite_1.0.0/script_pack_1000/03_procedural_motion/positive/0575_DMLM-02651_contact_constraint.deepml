deepml motion 0.3
module corpus.deepml_motion.example_02651
policy deterministic
policy no_network
skeleton Rig02651 { joint Root parent none joint Hip parent Root joint FootL parent Hip joint FootR parent Hip }
procedural animation Procedural02651 seed 2651 {
  trajectory = predict_trajectory(velocity, horizon=1.0s)
  match = motion_match(database="local:motions_5", trajectory=trajectory)
  constrain contact FootL to ground when phase < 0.5
  constrain contact FootR to ground when phase >= 0.5
}
layered state_machine Layers02651 { base: Locomotion upper: Gesture additive: Breathing }
synchronize Procedural02651 with scene.Actor16 and timeline.Sequence12
