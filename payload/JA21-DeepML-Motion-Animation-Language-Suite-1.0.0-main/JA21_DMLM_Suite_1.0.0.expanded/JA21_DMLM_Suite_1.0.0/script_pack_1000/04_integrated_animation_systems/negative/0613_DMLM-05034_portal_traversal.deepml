deepml motion 0.3
module corpus.deepml_motion.example_05034
policy deterministic
policy no_network
character Rig05034 {
  skeleton Humanoid4
  controller Locomotion { blend: locomotion_1 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_7" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05034 agents 94 controller Rig05034 avoidance deterministic
package motion Rig05034 as "motion_05034.msslb"
verify motion_hash == "invalid-05034"
