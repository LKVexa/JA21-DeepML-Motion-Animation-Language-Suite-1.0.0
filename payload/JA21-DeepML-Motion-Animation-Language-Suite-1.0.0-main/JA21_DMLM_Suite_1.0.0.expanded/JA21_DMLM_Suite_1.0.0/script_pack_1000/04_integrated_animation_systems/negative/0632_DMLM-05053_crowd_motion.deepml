deepml motion 0.3
module corpus.deepml_motion.example_05053
policy deterministic
policy no_network
character Rig05053 {
  skeleton Humanoid3
  controller Locomotion { blend: locomotion_6 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_4" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05053 agents 23 controller Rig05053 avoidance deterministic
package motion Rig05053 as "motion_05053.msslb"
verify motion_hash == "invalid-05053"
