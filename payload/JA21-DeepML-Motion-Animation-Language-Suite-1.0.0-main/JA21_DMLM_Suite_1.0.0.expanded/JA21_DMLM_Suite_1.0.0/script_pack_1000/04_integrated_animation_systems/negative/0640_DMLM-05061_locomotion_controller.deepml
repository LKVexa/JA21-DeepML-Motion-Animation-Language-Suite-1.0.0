deepml motion 0.3
module corpus.deepml_motion.example_05061
policy deterministic
policy no_network
character Rig05061 {
  skeleton Humanoid1
  controller Locomotion { blend: locomotion_0 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_1" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05061 agents 31 controller Rig05061 avoidance deterministic
package motion Rig05061 as "motion_05061.msslb"
verify motion_hash == "invalid-05061"
