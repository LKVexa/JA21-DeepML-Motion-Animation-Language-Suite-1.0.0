deepml motion 0.3
module corpus.deepml_motion.example_05126
policy deterministic
policy no_network
character Rig05126 {
  skeleton Humanoid1
  controller Locomotion { blend: locomotion_2 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_0" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05126 agents 96 controller Rig05126 avoidance deterministic
package motion Rig05126 as "motion_05126.msslb"
verify motion_hash == "invalid-05126"
