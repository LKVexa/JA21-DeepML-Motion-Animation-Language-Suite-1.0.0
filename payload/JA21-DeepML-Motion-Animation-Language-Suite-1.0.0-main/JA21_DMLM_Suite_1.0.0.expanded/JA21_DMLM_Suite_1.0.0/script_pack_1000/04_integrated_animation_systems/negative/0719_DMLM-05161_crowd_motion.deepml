deepml motion 0.3
module corpus.deepml_motion.example_05161
policy deterministic
policy no_network
character Rig05161 {
  skeleton Humanoid1
  controller Locomotion { blend: locomotion_2 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_2" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05161 agents 41 controller Rig05161 avoidance deterministic
package motion Rig05161 as "motion_05161.msslb"
verify motion_hash == "invalid-05161"
