deepml motion 0.3
module corpus.deepml_motion.example_05188
policy deterministic
policy no_network
character Rig05188 {
  skeleton Humanoid3
  controller Locomotion { blend: locomotion_1 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_7" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05188 agents 68 controller Rig05188 avoidance deterministic
package motion Rig05188 as "motion_05188.msslb"
verify motion_hash == "invalid-05188"
