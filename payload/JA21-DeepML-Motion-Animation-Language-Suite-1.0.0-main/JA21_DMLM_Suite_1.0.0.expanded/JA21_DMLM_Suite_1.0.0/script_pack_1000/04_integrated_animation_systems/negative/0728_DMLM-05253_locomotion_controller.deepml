deepml motion 0.3
module corpus.deepml_motion.example_05253
policy deterministic
policy no_network
character Rig05253 {
  skeleton Humanoid3
  controller Locomotion { blend: locomotion_3 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_6" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05253 agents 43 controller Rig05253 avoidance deterministic
package motion Rig05253 as "motion_05253.msslb"
verify motion_hash == "invalid-05253"
