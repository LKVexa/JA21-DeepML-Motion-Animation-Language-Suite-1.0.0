deepml motion 0.3
module corpus.deepml_motion.example_05272
policy deterministic
policy no_network
character Rig05272 {
  skeleton Humanoid2
  controller Locomotion { blend: locomotion_1 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_3" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05272 agents 62 controller Rig05272 avoidance deterministic
package motion Rig05272 as "motion_05272.msslb"
verify motion_hash == "invalid-05272"
