deepml motion 0.3
module corpus.deepml_motion.example_05280
policy deterministic
policy no_network
character Rig05280 {
  skeleton Humanoid0
  controller Locomotion { blend: locomotion_2 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_0" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05280 agents 70 controller Rig05280 avoidance deterministic
package motion Rig05280 as "motion_05280.msslb"
verify motion_hash == "invalid-05280"
