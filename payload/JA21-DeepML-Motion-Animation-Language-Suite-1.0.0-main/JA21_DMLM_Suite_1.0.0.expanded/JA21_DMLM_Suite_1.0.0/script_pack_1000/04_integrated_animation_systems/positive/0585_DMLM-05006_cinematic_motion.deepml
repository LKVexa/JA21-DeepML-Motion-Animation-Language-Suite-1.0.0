deepml motion 0.3
module corpus.deepml_motion.example_05006
policy deterministic
policy no_network
character Rig05006 {
  skeleton Humanoid1
  controller Locomotion { blend: locomotion_1 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_1" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05006 agents 66 controller Rig05006 avoidance deterministic
package motion Rig05006 as "motion_05006.msslb"
