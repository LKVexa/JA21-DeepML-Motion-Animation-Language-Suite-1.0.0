deepml motion 0.3
module corpus.deepml_motion.example_05008
policy deterministic
policy no_network
character Rig05008 {
  skeleton Humanoid3
  controller Locomotion { blend: locomotion_3 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_3" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05008 agents 68 controller Rig05008 avoidance deterministic
package motion Rig05008 as "motion_05008.msslb"
