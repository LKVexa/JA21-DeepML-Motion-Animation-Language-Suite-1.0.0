deepml motion 0.3
module corpus.deepml_motion.example_05011
policy deterministic
policy no_network
character Rig05011 {
  skeleton Humanoid1
  controller Locomotion { blend: locomotion_6 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_6" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05011 agents 71 controller Rig05011 avoidance deterministic
package motion Rig05011 as "motion_05011.msslb"
