deepml motion 0.3
module corpus.deepml_motion.example_05013
policy deterministic
policy no_network
character Rig05013 {
  skeleton Humanoid3
  controller Locomotion { blend: locomotion_1 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_8" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05013 agents 73 controller Rig05013 avoidance deterministic
package motion Rig05013 as "motion_05013.msslb"
