deepml motion 0.3
module corpus.deepml_motion.example_05014
policy deterministic
policy no_network
character Rig05014 {
  skeleton Humanoid4
  controller Locomotion { blend: locomotion_2 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_9" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05014 agents 74 controller Rig05014 avoidance deterministic
package motion Rig05014 as "motion_05014.msslb"
