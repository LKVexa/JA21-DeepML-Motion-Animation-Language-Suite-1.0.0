deepml motion 0.3
module corpus.deepml_motion.example_05017
policy deterministic
policy no_network
character Rig05017 {
  skeleton Humanoid2
  controller Locomotion { blend: locomotion_5 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_1" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05017 agents 77 controller Rig05017 avoidance deterministic
package motion Rig05017 as "motion_05017.msslb"
