deepml motion 0.3
module corpus.deepml_motion.example_05018
policy deterministic
policy no_network
character Rig05018 {
  skeleton Humanoid3
  controller Locomotion { blend: locomotion_6 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_2" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05018 agents 78 controller Rig05018 avoidance deterministic
package motion Rig05018 as "motion_05018.msslb"
