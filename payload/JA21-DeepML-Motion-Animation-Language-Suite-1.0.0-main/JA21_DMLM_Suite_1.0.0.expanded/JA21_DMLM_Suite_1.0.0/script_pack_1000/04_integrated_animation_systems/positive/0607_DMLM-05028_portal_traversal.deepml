deepml motion 0.3
module corpus.deepml_motion.example_05028
policy deterministic
policy no_network
character Rig05028 {
  skeleton Humanoid3
  controller Locomotion { blend: locomotion_2 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_1" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05028 agents 88 controller Rig05028 avoidance deterministic
package motion Rig05028 as "motion_05028.msslb"
