deepml motion 0.3
module corpus.deepml_motion.example_05032
policy deterministic
policy no_network
character Rig05032 {
  skeleton Humanoid2
  controller Locomotion { blend: locomotion_6 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_5" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05032 agents 92 controller Rig05032 avoidance deterministic
package motion Rig05032 as "motion_05032.msslb"
