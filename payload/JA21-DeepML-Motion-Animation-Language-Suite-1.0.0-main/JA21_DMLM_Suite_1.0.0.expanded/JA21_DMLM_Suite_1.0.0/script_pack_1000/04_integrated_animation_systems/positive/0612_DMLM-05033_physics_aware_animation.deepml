deepml motion 0.3
module corpus.deepml_motion.example_05033
policy deterministic
policy no_network
character Rig05033 {
  skeleton Humanoid3
  controller Locomotion { blend: locomotion_0 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_6" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05033 agents 93 controller Rig05033 avoidance deterministic
package motion Rig05033 as "motion_05033.msslb"
