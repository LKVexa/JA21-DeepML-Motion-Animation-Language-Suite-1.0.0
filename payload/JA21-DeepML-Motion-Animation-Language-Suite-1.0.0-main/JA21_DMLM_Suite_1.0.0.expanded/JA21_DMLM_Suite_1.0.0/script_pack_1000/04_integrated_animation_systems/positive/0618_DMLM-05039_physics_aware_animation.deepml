deepml motion 0.3
module corpus.deepml_motion.example_05039
policy deterministic
policy no_network
character Rig05039 {
  skeleton Humanoid4
  controller Locomotion { blend: locomotion_6 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_1" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05039 agents 99 controller Rig05039 avoidance deterministic
package motion Rig05039 as "motion_05039.msslb"
