deepml motion 0.3
module corpus.deepml_motion.example_05040
policy deterministic
policy no_network
character Rig05040 {
  skeleton Humanoid0
  controller Locomotion { blend: locomotion_0 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_2" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05040 agents 10 controller Rig05040 avoidance deterministic
package motion Rig05040 as "motion_05040.msslb"
