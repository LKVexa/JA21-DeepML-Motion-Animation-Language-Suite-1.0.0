deepml motion 0.3
module corpus.deepml_motion.example_05042
policy deterministic
policy no_network
character Rig05042 {
  skeleton Humanoid2
  controller Locomotion { blend: locomotion_2 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_4" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05042 agents 12 controller Rig05042 avoidance deterministic
package motion Rig05042 as "motion_05042.msslb"
