deepml motion 0.3
module corpus.deepml_motion.example_05044
policy deterministic
policy no_network
character Rig05044 {
  skeleton Humanoid4
  controller Locomotion { blend: locomotion_4 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_6" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05044 agents 14 controller Rig05044 avoidance deterministic
package motion Rig05044 as "motion_05044.msslb"
