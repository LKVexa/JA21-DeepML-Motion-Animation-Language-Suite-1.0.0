deepml motion 0.3
module corpus.deepml_motion.example_05051
policy deterministic
policy no_network
character Rig05051 {
  skeleton Humanoid1
  controller Locomotion { blend: locomotion_4 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_2" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05051 agents 21 controller Rig05051 avoidance deterministic
package motion Rig05051 as "motion_05051.msslb"
