deepml motion 0.3
module corpus.deepml_motion.example_05052
policy deterministic
policy no_network
character Rig05052 {
  skeleton Humanoid2
  controller Locomotion { blend: locomotion_5 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_3" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05052 agents 22 controller Rig05052 avoidance deterministic
package motion Rig05052 as "motion_05052.msslb"
