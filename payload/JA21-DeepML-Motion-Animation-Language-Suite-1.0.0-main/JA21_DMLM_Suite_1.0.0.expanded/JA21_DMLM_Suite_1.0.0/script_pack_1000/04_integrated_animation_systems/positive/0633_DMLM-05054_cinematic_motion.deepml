deepml motion 0.3
module corpus.deepml_motion.example_05054
policy deterministic
policy no_network
character Rig05054 {
  skeleton Humanoid4
  controller Locomotion { blend: locomotion_0 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_5" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05054 agents 24 controller Rig05054 avoidance deterministic
package motion Rig05054 as "motion_05054.msslb"
