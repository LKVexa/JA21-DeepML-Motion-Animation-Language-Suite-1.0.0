deepml motion 0.3
module corpus.deepml_motion.example_05056
policy deterministic
policy no_network
character Rig05056 {
  skeleton Humanoid1
  controller Locomotion { blend: locomotion_2 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_7" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05056 agents 26 controller Rig05056 avoidance deterministic
package motion Rig05056 as "motion_05056.msslb"
