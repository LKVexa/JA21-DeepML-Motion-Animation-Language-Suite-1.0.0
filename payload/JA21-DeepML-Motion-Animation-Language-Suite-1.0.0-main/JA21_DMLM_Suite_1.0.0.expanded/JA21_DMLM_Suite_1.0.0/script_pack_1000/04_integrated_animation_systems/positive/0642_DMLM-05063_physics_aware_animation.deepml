deepml motion 0.3
module corpus.deepml_motion.example_05063
policy deterministic
policy no_network
character Rig05063 {
  skeleton Humanoid3
  controller Locomotion { blend: locomotion_2 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_3" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
