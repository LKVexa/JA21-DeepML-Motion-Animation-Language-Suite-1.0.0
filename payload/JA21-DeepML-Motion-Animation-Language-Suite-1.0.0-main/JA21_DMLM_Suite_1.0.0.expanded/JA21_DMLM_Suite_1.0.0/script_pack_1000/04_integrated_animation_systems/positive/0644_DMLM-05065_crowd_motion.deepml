deepml motion 0.3
module corpus.deepml_motion.example_05065
policy deterministic
policy no_network
character Rig05065 {
  skeleton Humanoid0
  controller Locomotion { blend: locomotion_4 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_5" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05065 agents 35 controller Rig05065 avoidance deterministic
package motion Rig05065 as "motion_05065.msslb"
