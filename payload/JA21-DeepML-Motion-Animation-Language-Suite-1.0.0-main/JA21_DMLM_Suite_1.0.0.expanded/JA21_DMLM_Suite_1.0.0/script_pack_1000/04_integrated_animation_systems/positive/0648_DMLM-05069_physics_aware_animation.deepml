deepml motion 0.3
module corpus.deepml_motion.example_05069
policy deterministic
policy no_network
character Rig05069 {
  skeleton Humanoid4
  controller Locomotion { blend: locomotion_1 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_9" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05069 agents 39 controller Rig05069 avoidance deterministic
package motion Rig05069 as "motion_05069.msslb"
