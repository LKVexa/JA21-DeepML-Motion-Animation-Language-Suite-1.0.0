deepml motion 0.3
module corpus.deepml_motion.example_05070
policy deterministic
policy no_network
character Rig05070 {
  skeleton Humanoid0
  controller Locomotion { blend: locomotion_2 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_10" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05070 agents 40 controller Rig05070 avoidance deterministic
package motion Rig05070 as "motion_05070.msslb"
