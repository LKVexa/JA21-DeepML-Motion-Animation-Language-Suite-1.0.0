deepml motion 0.3
module corpus.deepml_motion.example_05073
policy deterministic
policy no_network
character Rig05073 {
  skeleton Humanoid3
  controller Locomotion { blend: locomotion_5 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_2" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05073 agents 43 controller Rig05073 avoidance deterministic
package motion Rig05073 as "motion_05073.msslb"
