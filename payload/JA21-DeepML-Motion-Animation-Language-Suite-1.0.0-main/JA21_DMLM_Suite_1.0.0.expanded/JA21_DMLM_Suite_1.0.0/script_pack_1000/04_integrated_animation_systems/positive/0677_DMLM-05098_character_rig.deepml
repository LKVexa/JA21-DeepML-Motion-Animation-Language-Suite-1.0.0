deepml motion 0.3
module corpus.deepml_motion.example_05098
policy deterministic
policy no_network
character Rig05098 {
  skeleton Humanoid3
  controller Locomotion { blend: locomotion_2 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_5" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05098 agents 68 controller Rig05098 avoidance deterministic
package motion Rig05098 as "motion_05098.msslb"
