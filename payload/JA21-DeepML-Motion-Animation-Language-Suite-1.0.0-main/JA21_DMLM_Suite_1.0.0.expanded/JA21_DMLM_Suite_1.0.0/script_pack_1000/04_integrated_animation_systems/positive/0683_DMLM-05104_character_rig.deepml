deepml motion 0.3
module corpus.deepml_motion.example_05104
policy deterministic
policy no_network
character Rig05104 {
  skeleton Humanoid4
  controller Locomotion { blend: locomotion_1 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_0" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05104 agents 74 controller Rig05104 avoidance deterministic
package motion Rig05104 as "motion_05104.msslb"
