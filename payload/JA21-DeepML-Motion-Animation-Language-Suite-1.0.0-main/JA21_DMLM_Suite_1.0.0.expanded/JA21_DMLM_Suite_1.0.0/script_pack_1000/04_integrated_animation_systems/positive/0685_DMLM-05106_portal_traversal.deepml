deepml motion 0.3
module corpus.deepml_motion.example_05106
policy deterministic
policy no_network
character Rig05106 {
  skeleton Humanoid1
  controller Locomotion { blend: locomotion_3 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_2" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05106 agents 76 controller Rig05106 avoidance deterministic
package motion Rig05106 as "motion_05106.msslb"
