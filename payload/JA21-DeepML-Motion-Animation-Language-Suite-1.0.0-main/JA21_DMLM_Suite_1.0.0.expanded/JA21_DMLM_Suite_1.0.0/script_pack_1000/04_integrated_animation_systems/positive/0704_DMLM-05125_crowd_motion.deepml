deepml motion 0.3
module corpus.deepml_motion.example_05125
policy deterministic
policy no_network
character Rig05125 {
  skeleton Humanoid0
  controller Locomotion { blend: locomotion_1 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_10" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05125 agents 95 controller Rig05125 avoidance deterministic
package motion Rig05125 as "motion_05125.msslb"
