deepml motion 0.3
module corpus.deepml_motion.example_05131
policy deterministic
policy no_network
character Rig05131 {
  skeleton Humanoid1
  controller Locomotion { blend: locomotion_0 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_5" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05131 agents 11 controller Rig05131 avoidance deterministic
package motion Rig05131 as "motion_05131.msslb"
