deepml motion 0.3
module corpus.deepml_motion.example_05132
policy deterministic
policy no_network
character Rig05132 {
  skeleton Humanoid2
  controller Locomotion { blend: locomotion_1 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_6" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05132 agents 12 controller Rig05132 avoidance deterministic
package motion Rig05132 as "motion_05132.msslb"
