deepml motion 0.3
module corpus.deepml_motion.example_05140
policy deterministic
policy no_network
character Rig05140 {
  skeleton Humanoid0
  controller Locomotion { blend: locomotion_2 ik: feet trajectory: predictive }
  controller Cinematic { timeline: "cinematic_3" masks: [upper_body, face] }
  portal traversal { entry_pose: PortalEnter exit_pose: PortalExit root_motion: preserve }
  physics coupling { ragdoll: bounded recovery: deterministic }
}
crowd motion Crowd05140 agents 20 controller Rig05140 avoidance deterministic
package motion Rig05140 as "motion_05140.msslb"
